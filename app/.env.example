# Copy to app/.env — used by: flutter run --dart-define-from-file=.env

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Vercel KYC gateway (JWT proxy to ML worker)
KYC_SERVICE_URL=https://kycservice.vercel.app

# Android (primary): must match Supabase edge secret CLIENT_APP_URL
CLIENT_APP_URL=gadgetchai://

# Web (optional): use http://localhost:3000 in a separate .env.web file

# WhatsApp support number (country code + number, no +)
SUPPORT_WHATSAPP=8801700000000
